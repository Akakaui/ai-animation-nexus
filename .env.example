# Runtime
NODE_ENV=development
PORT=3001
BASE_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# Required production secrets
ADMIN_PASSWORD=replace-with-a-strong-12-character-minimum-password
CRON_SECRET=replace-with-a-long-random-secret
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
RESEND_API_KEY=re_replace_me
EMAIL_FROM=AI Animation Nexus <noreply@example.com>

# Payment window: free for first 20 days, paid at $2.99 for the next 10 days
PAYMENT_CURRENCY=USD
PAYMENT_AMOUNT_MAJOR=2.99
PAYMENT_AMOUNT_MINOR=299
PAYMENT_FREE_DAYS=20
PAYMENT_PAID_DAYS=10
# Set this to an RFC3339 timestamp to start the automatic window.
# PAYMENT_WINDOW_START=2026-09-01T00:00:00Z
# Optional override: free, paid, or closed
# PAYMENT_MODE=free

# Persistence: Vercel/Upstash Redis or KV REST credentials
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel KV-compatible aliases, if provided by the connected store
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Session and community links
DEFAULT_ZOOM_URL=https://zoom.us/j/replace-me
WHATSAPP_CHANNEL_LINK=https://chat.whatsapp.com/replace-me

# Optional SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
